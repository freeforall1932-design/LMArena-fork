{
  // Version number
  // Used by the auto-update check; please do not modify it manually.
  "version": "2.8.0",

  // --- Server settings ---
  // Address the API server binds to.
  // "127.0.0.1" only allows connections from this machine (recommended).
  // Set to "0.0.0.0" to allow access from other devices or Docker containers.
  // Note: if you change server_port, you must also update the port in the
  // Tampermonkey script (SERVER_URL) accordingly.
  "server_host": "127.0.0.1",
  "server_port": 5102,

  // --- Session settings ---
  // Session ID of the current LMArena page.
  // Updated automatically by running id_updater.py.
  "session_id": "eb89f76a-91c9-4a68-89d8-f48783dfea0a",

  // ID of the last message in the current session.
  // Updated automatically by running id_updater.py.
  "message_id": "13639031-cf51-4d86-8f31-13fe28c684fb",

  // --- ID updater settings ---
  // Mode last used by id_updater.py ('direct_chat' or 'battle')
  "id_updater_last_mode": "direct_chat",
  // Target to update in Battle mode for id_updater.py ('A' or 'B')
  "id_updater_battle_target": "A",

  // --- Update settings ---
  // Toggle: automatically check for updates
  // When true, the program connects to GitHub at startup to check for a new version.
  "enable_auto_update": true,

  // --- Feature toggles ---

  // Feature toggle: bypass sensitive-word detection
  // Injects an extra user message with empty content into the original
  // conversation in an attempt to bypass sensitive-word moderation.
  "bypass_enabled": true,

  // Feature toggle: Tavern Mode
  // Designed for scenarios that require full history injection
  // (SillyTavern and similar applications).
  "tavern_mode_enabled": false,

  // --- Model mapping settings ---

  // Toggle: use the default IDs when no model mapping exists
  // When true, if the requested model is not found in model_endpoint_map.json,
  // the global session_id and message_id defined in config.jsonc are used.
  // When false, a missing mapping returns an error instead.
  "use_default_ids_if_mapping_not_found": true,

  // --- Advanced settings ---

  // Streaming response timeout (seconds)
  // Maximum time the server waits for the next chunk of data from the browser.
  // Also used for non-streaming responses.
  // Increase this value if you are on a slow network or the model responds slowly.
  "stream_response_timeout_seconds": 360,

  // --- Auto-restart settings ---

  // Toggle: enable idle auto-restart
  // When the server receives no API requests for the configured period
  // (see below), it restarts automatically.
  "enable_idle_restart": true,

  // Idle restart timeout (seconds)
  // After startup checks and updates complete, the server restarts if no
  // request arrives within this period.
  // 5 minutes = 300 seconds. Set to -1 to disable the timeout entirely
  // (even when the toggle above is true).
  "idle_restart_timeout_seconds": -1,

  // --- Security settings ---

  // API Key
  // Set an API key to protect your service.
  // When set, every request to /v1/chat/completions must include the correct
  // Bearer token in the Authorization header.
  "api_key": ""
}
